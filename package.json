{
  "name": "better-ink-ui",
  "version": "0.1.0",
  "description": "Generic, fast UI primitives for Ink: themed Box and Text, mouse input, virtualized scroll views, text selection, a multiline text area, focus management, and off-thread terminal images.",
  "keywords": [
    "ink",
    "react",
    "terminal",
    "tui",
    "cli",
    "mouse",
    "scroll",
    "textarea",
    "selection",
    "focus",
    "image",
    "kitty"
  ],
  "author": "Ryan Garber",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    },
    "./worker": {
      "types": "./dist/worker.d.mts",
      "default": "./dist/worker.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run .",
    "build": "tsdown"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <27",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "peerDependencies": {
    "ink": ">=8",
    "react": ">=19",
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "omggif": "^1.0.10",
    "string-width": "^9.0.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@ryangarber/utils": "^0.1.6",
    "@types/node": "^26.6.6",
    "@types/omggif": "^1.0.5",
    "@types/react": "^19.3.0",
    "ink": "^8.0.0",
    "knip": "^6.44.1",
    "react": "^19.3.1",
    "sharp": "^0.35.5",
    "tsdown": "^0.23.5",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.0"
  }
}
